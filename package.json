{
  "name": "ai-corporate-training-assistant",
  "version": "1.0.0",
  "description": "Production-ready Electron desktop app for AI-assisted corporate training design.",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "build": "vite build && electron-builder",
    "build:renderer": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "start": "electron ."
  },
  "keywords": [
    "electron",
    "react",
    "gemini",
    "corporate-training",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@vitejs/plugin-react": "^4.7.0",
    "better-sqlite3": "^11.10.0",
    "date-fns": "^4.1.0",
    "docx": "^9.5.1",
    "electron-store": "^10.1.0",
    "file-type": "^20.5.0",
    "framer-motion": "^12.23.0",
    "html-to-pdfmake": "^2.5.31",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.1",
    "nanoid": "^5.1.5",
    "pdf-parse": "^1.1.1",
    "pdfmake": "^0.2.20",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-hot-toast": "^2.5.2",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sanitize-filename": "^1.6.3",
    "tailwind-merge": "^2.6.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "eslint": "^9.30.1",
    "eslint-plugin-react": "^7.37.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.19",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.local.aicorporatetrainingassistant",
    "productName": "AI Corporate Training Assistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  }
}
